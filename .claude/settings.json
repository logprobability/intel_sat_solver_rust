{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/queue-guard.py\"; [ ! -f \"$f\" ] || exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
